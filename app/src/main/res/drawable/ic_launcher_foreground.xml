<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: the graph screen's 3 concentric rings (radii in the same
     110:230:350 proportion as RING_RADII in graph_layout), one node on each
     ring, joined by 2 edges. Fits inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Rings -->
    <path
        android:pathData="M45.2,54 a8.8,8.8 0 1,0 17.6,0 a8.8,8.8 0 1,0 -17.6,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2" />
    <path
        android:pathData="M35.6,54 a18.4,18.4 0 1,0 36.8,0 a18.4,18.4 0 1,0 -36.8,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2" />
    <path
        android:pathData="M26,54 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2" />

    <!-- Edges: outer ring node -> middle ring node -> inner ring node -->
    <path
        android:pathData="M34.2,34.2 L69.93,44.8 L60.22,60.22"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Nodes -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30.6,34.2 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M66.33,44.8 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M56.62,60.22 a3.6,3.6 0 1,0 7.2,0 a3.6,3.6 0 1,0 -7.2,0" />
</vector>
